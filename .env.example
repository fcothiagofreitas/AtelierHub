# ─── Banco de dados ───────────────────────────────────────────────────────────
# PostgreSQL via Docker (docker-compose.yml já sobe o container)
DATABASE_URL="postgresql://atelierhub:atelierhub@localhost:5433/atelierhub_dev"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_ISSO_POR_UM_SEGREDO_REAL"
# URL pública do browser (em produção por IP: http://SEU_IP — não usar localhost).
# Com HTTPS atrás de nginx: use https://seu-dominio (alinha cookies Secure com o browser).
NEXTAUTH_URL="http://localhost:3000"
# Opcional: forçar flag Secure nos cookies (atalhos loja + NextAuth). Omitido = só se NEXTAUTH_URL for https://
# COOKIE_SECURE=false

# ─── Senha padrão de reset ────────────────────────────────────────────────────
# Usada pelo reset administrativo de senha
DEFAULT_RESET_PASSWORD="Mudar@123"

# ─── Asaas (opcional — habilita lookup de nome por CPF via chave Pix) ────────
# Obtenha em: Minha Conta → Configurações → Chave de API
# Sandbox:   https://sandbox.asaas.com
# Produção:  https://www.asaas.com
ASAAS_API_KEY=""
# ASAAS_API_URL="https://api.asaas.com"   # omitir = produção; sandbox: https://api-sandbox.asaas.com

# ─── Sentry (opcional — sem DSN o SDK não envia eventos) ─────────────────────
# Cliente + servidor: https://docs.sentry.io/product/sentry-basics/dsn-explainer/
NEXT_PUBLIC_SENTRY_DSN=""
# Opcional: upload de source maps no build (CI / máquina local com build de release)
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
