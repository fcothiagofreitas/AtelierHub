# ─── Banco de dados ───────────────────────────────────────────────────────────
# PostgreSQL via Docker (docker-compose.yml já sobe o container)
DATABASE_URL="postgresql://atelierhub:atelierhub@localhost:5433/atelierhub_dev"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="TROQUE_ISSO_POR_UM_SEGREDO_REAL"
NEXTAUTH_URL="http://localhost:3000"

# ─── Senha padrão de reset ────────────────────────────────────────────────────
# Usada pelo reset administrativo de senha
DEFAULT_RESET_PASSWORD="Mudar@123"

# ─── Sentry (opcional — sem DSN o SDK não envia eventos) ─────────────────────
# Cliente + servidor: https://docs.sentry.io/product/sentry-basics/dsn-explainer/
NEXT_PUBLIC_SENTRY_DSN=""
# Opcional: upload de source maps no build (CI / máquina local com build de release)
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
