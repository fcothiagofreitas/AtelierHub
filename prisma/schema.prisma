generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN_DA_MARCA
  ADMINISTRATIVO
  GERENTE_LOJA
  VENDEDOR
}

enum StoreKind {
  ADMINISTRATIVE
  OPERATIONAL
}

enum CorretorPaymentMethod {
  PIX
  CASH
  BANK_TRANSFER
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  stores       Store[]
  colaboradores Colaborador[]
  corretores   Corretor[]
  users        User[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Corretor: parceiro externo — não é Colaborador. Limite de crédito (consignado) opcional (null = ilimitado).
model Corretor {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  document String?
  email    String?
  phone    String?

  commissionPercent Float @default(0)

  paymentMethod CorretorPaymentMethod @default(PIX)
  pixKey        String?
  bankName      String?
  bankBranch    String?
  bankAccount   String?
  notes         String?

  /// Exposição máxima em aberto (consignado). Null = sem teto cadastral (ilimitado).
  creditLimitConsignado Decimal? @db.Decimal(14, 2)

  isActive  Boolean @default(true)
  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Store {
  id               String             @id @default(cuid())
  tenantId         String
  name             String
  slug             String
  kind             StoreKind          @default(OPERATIONAL)
  isActive         Boolean            @default(true)
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  colaboradorAccess ColaboradorStore[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// Qualquer pessoa que trabalha na empresa: admin, gerente, vendedor.
// Acesso ao sistema é opcional — criado via toggle no formulário.
model Colaborador {
  id            String            @id @default(cuid())
  tenantId      String
  name          String
  cpf           String?
  phone         String?
  admissionAt   DateTime?
  dismissalAt   DateTime?
  isDismissed   Boolean           @default(false)
  minCommission Float             @default(0)
  isActive      Boolean           @default(true)
  role          UserRole

  // Acesso ao sistema — opcional
  userId        String?           @unique
  user          User?             @relation(fields: [userId], references: [id])

  stores        ColaboradorStore[]
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId])
}

model ColaboradorStore {
  id            String      @id @default(cuid())
  colaboradorId String
  storeId       String
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([colaboradorId, storeId])
  @@index([colaboradorId])
  @@index([storeId])
}

// Apenas credenciais de login. Toda pessoa é um Colaborador primeiro.
model User {
  id           String       @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  isActive     Boolean      @default(true)

  colaborador  Colaborador?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}
